# Portal 认证账号配置
USERNAME=
PASSWORD=
# 支持@CMCC，或者校园网留空，其他宽带出口请自行抓包
ACCOUNT_SUFFIX=
# IPv6 手动指定（留空则自动获取本机全局IPv6）
IPV6_ADDRESS=

DEBUG=false

# WebUI 端口、日志文件路径、更新包下载目录
PORT=38080
LOG_FILE=/data/local/tmp/drcom_webui.log
DOWNLOAD_DIR=/sdcard/Download

# 自动认证（接入目标 ESSID 的 WiFi 时触发，断开停止）
AUTO_RUN=false
TARGET_ESSID=
AUTO_INTERVAL=5

# 有线版专用
AUTH_SERVER=10.0.1.5         # 认证服务器 IP（一般固定）